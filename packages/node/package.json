{
  "name": "@b4moss/shardian",
  "version": "0.3.0",
  "description": "Create sharded path strings from filenames",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "rm -rf dist && tsc && node --test dist/shardian.test.js",
    "prepublishOnly": "npm run build",
    "test:coverage": "c8 --reporter=lcov --reporter=text npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "shard",
    "path",
    "directory",
    "filename"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b4moss/shardian",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/b4moss/shardian/issues"
  },
  "homepage": "https://github.com/b4moss/shardian#readme",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "c8": "^10.1.3"
  }
}
