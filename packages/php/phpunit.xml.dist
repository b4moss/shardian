<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="shardian">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src</directory>
    </include>
    <!--
      Data-only const loaded via Composer "files" autoload during PHPUnit bootstrap.
      PCOV/Xdebug start after bootstrap, so every array line would otherwise stay at 0%
      and drag port coverage (~48%) despite 100% logic coverage in ShardianInternal.
    -->
    <exclude>
      <file>src/CommonExtensions.php</file>
    </exclude>
  </source>
  <coverage>
    <report>
      <clover outputFile="coverage/clover.xml"/>
    </report>
  </coverage>
</phpunit>
